---
import PortalPage from '../components/PortalPage.astro';
---
<PortalPage title="Відновлення пароля" description="Ми надішлемо одноразове посилання, якщо акаунт існує."><form class="portal-form" data-json-form action="/api/auth/forgot-password"><label>Email<input name="email" type="email" autocomplete="email" required /></label><button class="button button--primary" type="submit">Надіслати інструкцію</button><p class="form-status" aria-live="polite"></p></form></PortalPage><script is:inline src="/scripts/forms.js"></script>

