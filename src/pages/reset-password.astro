---
import PortalPage from '../components/PortalPage.astro';
---
<PortalPage title="Новий пароль" description="Посилання діє одну годину й може бути використане один раз."><form class="portal-form" data-json-form action="/api/auth/reset-password" data-token-param="token" data-success="/login/"><label>Новий пароль<input name="password" type="password" autocomplete="new-password" minlength="12" required /></label><button class="button button--primary" type="submit">Зберегти пароль</button><p class="form-status" aria-live="polite"></p></form></PortalPage><script is:inline src="/scripts/forms.js"></script>

