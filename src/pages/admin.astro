---
import PortalPage from '../components/PortalPage.astro';
---
<PortalPage title="DepthLume" description="" eyebrow="DepthLume Control">
  <div class="admin-stats" data-stats></div>
  <section class="portal-card"><div class="card-head"><div><span class="eyebrow" data-i18n="filters"></span><h2 data-i18n="usersRequests"></h2></div><button class="button button--secondary" data-refresh data-i18n="refresh"></button></div>
    <form class="filter-row" data-filters><input name="search" data-i18n-placeholder="search" /><select name="applicationStatus" data-i18n-options="applications"></select><select name="accessStatus" data-i18n-options="accesses"></select><select name="archive" data-i18n-options="archiveFilter"></select><input name="dateFrom" type="date" data-i18n-title="from" /><input name="dateTo" type="date" data-i18n-title="to" /></form>
    <div class="table-wrap"><table><thead><tr><th data-i18n="user"></th><th data-i18n="status"></th><th data-i18n="granted"></th><th data-i18n="date"></th><th data-i18n="actions"></th></tr></thead><tbody data-applications></tbody></table></div><p class="form-status" data-admin-status aria-live="polite"></p></section>
  <section class="portal-card"><span class="eyebrow" data-i18n="releases"></span><h2 data-i18n="addRelease"></h2><form class="portal-form portal-form--wide" data-release-form><div class="form-grid"><label><span data-i18n="version"></span><input name="version" placeholder="0.1.0-beta.1" required /></label><label><span data-i18n="platform"></span><input name="supportedPlatform" value="Windows 10/11 x64" required /></label></div><label><span data-i18n="releaseNotes"></span><textarea name="releaseNotes" rows="4" required></textarea></label><label><span data-i18n="releaseFile"></span><input name="file" type="file" accept=".exe,.msi,.zip" required /></label><label class="check-row"><input name="isActive" type="checkbox" checked /><span data-i18n="makeActive"></span></label><progress class="release-progress" data-release-progress value="0" max="100" hidden></progress><div class="portal-actions"><button class="button button--primary" type="submit" data-i18n="uploadPrivate"></button><button class="button button--secondary" type="button" data-r2-diagnostic data-i18n="checkR2"></button></div><p class="form-status" aria-live="polite"></p></form><div class="table-wrap"><table><thead><tr><th data-i18n="version"></th><th data-i18n="file"></th><th data-i18n="downloads"></th><th data-i18n="status"></th><th data-i18n="actions"></th></tr></thead><tbody data-releases></tbody></table></div></section>
  <section class="portal-card"><span class="eyebrow" data-i18n="licenses"></span><h2 data-i18n="createKey"></h2><form class="portal-form portal-form--wide" data-license-form><div class="form-grid"><label><span data-i18n="betaEmail"></span><input name="email" type="email" required /></label><label><span data-i18n="licenseName"></span><input name="licenseName" value="Beta" required /></label></div><div class="form-grid"><label><span data-i18n="maxDevices"></span><input name="maxDevices" type="number" min="1" max="10" value="1" required /></label><label><span data-i18n="expires"></span><input name="expiresAt" type="datetime-local" /></label></div><button class="button button--primary" type="submit" data-i18n="createKey"></button><p class="form-status" data-license-status aria-live="polite"></p></form><div class="table-wrap"><table><thead><tr><th data-i18n="user"></th><th data-i18n="license"></th><th data-i18n="status"></th><th data-i18n="devices"></th><th data-i18n="expires"></th><th data-i18n="actions"></th></tr></thead><tbody data-licenses></tbody></table></div></section>
  <section class="portal-card"><span class="eyebrow">Feedback</span><div class="table-wrap"><table><thead><tr><th data-i18n="user"></th><th data-i18n="type"></th><th data-i18n="version"></th><th data-i18n="description"></th><th data-i18n="date"></th><th data-i18n="attachment"></th></tr></thead><tbody data-feedback></tbody></table></div></section>
</PortalPage>
<script type="module" is:inline src="/scripts/admin.js"></script>
