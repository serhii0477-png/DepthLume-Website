---
import PortalPage from '../components/PortalPage.astro';
---
<PortalPage title="Admin-панель" description="Керуйте beta-доступом, заявками, релізами, ліцензіями та журналом завантажень." eyebrow="DepthLume Control">
  <div class="admin-stats" data-stats></div>
  <section class="portal-card"><div class="card-head"><div><span class="eyebrow">Фільтри</span><h2>Користувачі та заявки</h2></div><button class="button button--secondary" data-refresh>Оновити</button></div><form class="filter-row" data-filters><input name="search" placeholder="Email або ім’я" /><select name="applicationStatus"><option value="">Усі заявки</option><option value="pending">pending</option><option value="approved">approved</option><option value="waitlist">waitlist</option><option value="rejected">rejected</option></select><select name="accessStatus"><option value="">Усі доступи</option><option>none</option><option>pending</option><option>beta</option><option>waitlist</option><option>revoked</option></select><input name="dateFrom" type="date" title="Реєстрація від" /><input name="dateTo" type="date" title="Реєстрація до" /></form><div class="table-wrap"><table><thead><tr><th>Користувач</th><th>Заявка</th><th>Доступ</th><th>Дата</th><th>Дії</th></tr></thead><tbody data-applications></tbody></table></div><p class="form-status" data-admin-status></p></section>
  <section class="portal-card"><span class="eyebrow">Релізи</span><h2>Додати нову версію</h2><form class="portal-form portal-form--wide" data-release-form><div class="form-grid"><label>Версія<input name="version" placeholder="0.1.0-beta.1" required /></label><label>Платформа<input name="supportedPlatform" value="Windows 10/11 x64" required /></label></div><label>Опис релізу<textarea name="releaseNotes" rows="4" required></textarea></label><label>Файл EXE, MSI або ZIP (до 1 ГБ)<input name="file" type="file" accept=".exe,.msi,.zip" required /></label><label class="check-row"><input name="isActive" type="checkbox" checked /> Зробити активним релізом</label><progress class="release-progress" data-release-progress value="0" max="100" hidden aria-label="Прогрес завантаження"></progress><div class="portal-actions"><button class="button button--primary" type="submit">Завантажити приватно</button><button class="button button--secondary" type="button" data-r2-diagnostic>Перевірити R2</button></div><p class="form-status" aria-live="polite"></p></form><div class="table-wrap"><table><thead><tr><th>Версія</th><th>Файл</th><th>Завантаження</th><th>Статус</th><th>Дії</th></tr></thead><tbody data-releases></tbody></table></div></section>
  <section class="portal-card"><span class="eyebrow">Ліцензії Radar</span><h2>Створити ключ активації</h2><form class="portal-form portal-form--wide" data-license-form><div class="form-grid"><label>Email beta-користувача<input name="email" type="email" required /></label><label>Назва ліцензії<input name="licenseName" value="Beta" required /></label></div><div class="form-grid"><label>Максимум пристроїв<input name="maxDevices" type="number" min="1" max="10" value="1" required /></label><label>Діє до (необов’язково)<input name="expiresAt" type="datetime-local" /></label></div><button class="button button--primary" type="submit">Створити ключ</button><p class="form-status" data-license-status aria-live="polite"></p></form><div class="table-wrap"><table><thead><tr><th>Користувач</th><th>Ліцензія</th><th>Статус</th><th>Пристрої</th><th>Діє до</th><th>Дії</th></tr></thead><tbody data-licenses></tbody></table></div></section>
  <section class="portal-card"><span class="eyebrow">Feedback</span><div class="table-wrap"><table><thead><tr><th>Користувач</th><th>Тип</th><th>Версія</th><th>Опис</th><th>Дата</th><th>Вкладення</th></tr></thead><tbody data-feedback></tbody></table></div></section>
</PortalPage>
<script type="module" is:inline src="/scripts/admin.js"></script>
