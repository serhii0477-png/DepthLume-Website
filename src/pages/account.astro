---
import PortalPage from '../components/PortalPage.astro';
---
<PortalPage title="Особистий кабінет" description="Статус beta-доступу, поточний реліз і зв’язок із командою."><div class="portal-dashboard" data-dashboard><section class="portal-card"><div class="card-head"><div><span class="eyebrow">Акаунт</span><h2 data-name>Завантаження…</h2></div><span class="status-badge" data-account-status>—</span></div><dl class="data-list"><div><dt>Email</dt><dd data-email>—</dd></div><div><dt>Статус заявки</dt><dd data-application>—</dd></div><div><dt>Статус доступу</dt><dd data-access>—</dd></div><div><dt>Доступ надано</dt><dd data-granted>—</dd></div></dl><div class="portal-actions"><a class="button button--primary" href="/apply/" data-primary-action>Подати заявку</a><button class="button button--secondary" type="button" data-logout>Вийти</button></div><p class="form-status" data-dashboard-status aria-live="polite"></p></section><section class="portal-card"><span class="eyebrow">Поточний реліз</span><h2 data-release-version>Файл ще не опубліковано</h2><p data-release-notes>Адміністратор опублікує перший beta-реліз після перевірки.</p><dl class="data-list"><div><dt>Платформа</dt><dd data-release-platform>Windows 10/11 x64</dd></div><div><dt>Розмір</dt><dd data-release-size>—</dd></div></dl></section></div>
<section class="portal-card feedback-card" data-feedback-card hidden><span class="eyebrow">Beta feedback</span><h2>Повідомити про помилку або пропозицію</h2><form class="portal-form portal-form--wide" action="/api/feedback" enctype="multipart/form-data" data-feedback-form><div class="form-grid"><label>Тип<select name="type"><option value="bug">Помилка</option><option value="suggestion">Пропозиція</option><option value="other">Інше</option></select></label><label>Версія<input name="softwareVersion" required /></label></div><label>Опис<textarea name="description" rows="4" minlength="20" required></textarea></label><label>Кроки для відтворення<textarea name="reproductionSteps" rows="3"></textarea></label><div class="form-grid"><label>Очікувана поведінка<textarea name="expectedBehavior" rows="3"></textarea></label><label>Фактична поведінка<textarea name="actualBehavior" rows="3"></textarea></label></div><label>Скріншот або log-файл (до 10 МБ)<input name="attachment" type="file" accept=".png,.jpg,.jpeg,.txt,.log,.zip" /></label><button class="button button--primary" type="submit">Надіслати</button><p class="form-status" aria-live="polite"></p></form></section>
</PortalPage>
<script>
  const value=(selector:string,text:string)=>{const element=document.querySelector<HTMLElement>(selector);if(element)element.textContent=text;};
  const formatBytes=(bytes:number)=>bytes?`${(bytes/1048576).toFixed(1)} МБ`:'—';
  fetch('/api/dashboard').then(async response=>{if(response.status===401){location.assign('/login/?next=/account/');return null;}return await response.json() as any;}).then(data=>{if(!data)return;value('[data-name]',data.user.name);value('[data-email]',data.user.email);value('[data-account-status]',data.user.emailVerified?'Підтверджено':'Не підтверджено');value('[data-application]',data.application?.status||'не подано');value('[data-access]',data.user.accessStatus);value('[data-granted]',data.user.betaGrantedAt?new Date(data.user.betaGrantedAt).toLocaleDateString('uk-UA'):'—');const action=document.querySelector<HTMLAnchorElement>('[data-primary-action]');if(action){if(data.user.accessStatus==='beta'){action.textContent='Завантажити DepthLume Radar';action.href='/api/download';const card=document.querySelector<HTMLElement>('[data-feedback-card]');if(card)card.hidden=false;}else if(data.user.accessStatus==='pending'){action.textContent='Заявка очікує на розгляд';action.href='/radar/';}else if(data.user.accessStatus==='waitlist'){action.textContent='Ви у списку очікування';action.href='/radar/';}else if(data.user.accessStatus==='revoked'){action.textContent='Доступ відкликано';action.href='/radar/';}}if(data.release){value('[data-release-version]',`DepthLume Radar ${data.release.version}`);value('[data-release-notes]',data.release.release_notes);value('[data-release-platform]',data.release.supported_platform);value('[data-release-size]',formatBytes(data.release.file_size));const version=document.querySelector<HTMLInputElement>('[name="softwareVersion"]');if(version)version.value=data.release.version;}}).catch(()=>value('[data-dashboard-status]','Не вдалося завантажити дані кабінету.'));
  document.querySelector('[data-logout]')?.addEventListener('click',async()=>{await fetch('/api/auth/logout',{method:'POST'});location.assign('/');});
  const feedbackForm=document.querySelector<HTMLFormElement>('[data-feedback-form]');
  feedbackForm?.addEventListener('submit',async event=>{event.preventDefault();const status=feedbackForm.querySelector<HTMLElement>('.form-status');const button=feedbackForm.querySelector<HTMLButtonElement>('button');if(button)button.disabled=true;if(status)status.textContent='Надсилання…';try{const response=await fetch(feedbackForm.action,{method:'POST',body:new FormData(feedbackForm)});const data=await response.json() as any;if(!response.ok)throw new Error(data.error);if(status)status.textContent=data.message;feedbackForm.reset();}catch(error){if(status)status.textContent=error instanceof Error?error.message:'Помилка.';}finally{if(button)button.disabled=false;}});
</script>
