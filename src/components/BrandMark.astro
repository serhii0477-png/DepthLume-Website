---
interface Props { class?: string; label?: string; }
const { class: className = '', label } = Astro.props;
---
<svg class:list={['brand-mark-svg', className]} viewBox="0 0 32 32" fill="none" role={label ? 'img' : undefined} aria-hidden={label ? undefined : 'true'} aria-label={label}>
  <path class="mark-shell" d="M6 5.5h10.2c6.3 0 10.3 4.1 10.3 10.5s-4 10.5-10.3 10.5H6v-21Z"/>
  <path class="mark-depth" d="M10 10h6c3.7 0 6 2.3 6 6s-2.3 6-6 6h-6V10Z"/>
  <path class="mark-light" d="M3.5 16h14.8M7 12.2h8.7M7 19.8h8.7"/>
</svg>

<style>
  .brand-mark-svg { width: 1.7rem; height: 1.7rem; flex: 0 0 auto; overflow: visible; }
  .mark-shell { fill: rgba(96,221,235,.07); stroke: currentColor; stroke-width: 1.35; }
  .mark-depth { stroke: currentColor; stroke-width: 1; opacity: .45; }
  .mark-light { stroke: currentColor; stroke-width: 1.35; stroke-linecap: round; }
</style>
