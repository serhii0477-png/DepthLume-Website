---
interface Props { eyebrow: string; title: string; description?: string; align?: 'left' | 'center'; }
const { eyebrow, title, description, align = 'left' } = Astro.props;
---
<header class:list={['section-heading', align === 'center' && 'section-heading--center']}>
  <span class="eyebrow">{eyebrow}</span>
  <h2>{title}</h2>
  {description && <p>{description}</p>}
</header>
