---
interface Props { number: string; title: string; note: string; }
const { number, title, note } = Astro.props;
---
<figure class="screenshot-frame">
  <div class="screenshot-bar"><span class="mono">VIEW {number}</span><span>Conceptual placeholder</span></div>
  <div class="screenshot-empty" aria-hidden="true">
    <svg viewBox="0 0 360 190"><path d="M1 189 58 132l38 21 59-81 40 49 47-27 57 44 60-81"/><path d="M1 161h358M1 118h358M1 75h358"/></svg>
    <span>Product screenshot pending</span>
  </div>
  <figcaption><strong>{title}</strong><p>{note}</p></figcaption>
</figure>

<style>
  .screenshot-frame { overflow: hidden; border: 1px solid var(--color-line); border-radius: var(--radius-md); background: var(--color-panel); }
  .screenshot-bar { display: flex; justify-content: space-between; gap: 1rem; padding: .7rem .9rem; border-bottom: 1px solid var(--color-line); color: var(--color-text-muted); font-size: .62rem; text-transform: uppercase; letter-spacing: .08em; }
  .screenshot-empty { position: relative; display: grid; min-height: 14rem; place-items: center; overflow: hidden; color: var(--color-text-muted); }
  .screenshot-empty svg { position: absolute; inset: 0; width: 100%; height: 100%; opacity: .18; }
  .screenshot-empty path { fill: none; stroke: var(--color-cyan); stroke-width: 1; }
  .screenshot-empty span { position: relative; padding: .5rem .7rem; border: 1px solid var(--color-line); border-radius: .3rem; background: rgba(5,12,18,.76); font: .65rem/1 var(--font-mono); text-transform: uppercase; letter-spacing: .08em; }
  figcaption { padding: 1rem; border-top: 1px solid var(--color-line); }
  figcaption strong { font-size: .9rem; }
  figcaption p { margin-top: .3rem; font-size: .76rem; }
</style>
