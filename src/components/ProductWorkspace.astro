---
import { existsSync } from 'node:fs';
import { join } from 'node:path';

interface Props {
  caption: string;
  alt: readonly [string, string, string, string];
  ui?: readonly [string, string, string, string, string];
}

const {
  caption,
  alt,
  ui = ['DepthLume Intelligence Workspace', 'Development interface', 'Real product crop', 'Market Context', 'Product imagery pending'],
} = Astro.props;

const productDir = join(process.cwd(), 'public', 'images', 'product');
const ready = [
  'depthlume-chart-clean.webp',
  'depthlume-market-context.webp',
  'depthlume-delta-cvd.webp',
  'depthlume-depth-map.webp',
  'depthlume-watchlist.webp',
].every((file) => existsSync(join(productDir, file)));
---

<figure class="product-workspace">
  <div class="workspace-label">
    <span class="mono">{ui[0]}</span>
    <span>{ui[1]}</span>
  </div>

  {ready ? (
    <div class="workspace-stage">
      <div class="monitor-aura" aria-hidden="true"></div>
      <div class="widescreen-monitor">
        <header class="terminal-titlebar">
          <div class="window-controls" aria-hidden="true"><i></i><i></i><i></i></div>
          <strong>DepthLume <span>/ Intelligence Workspace</span></strong>
          <div class="terminal-health mono"><i></i>PUBLIC DATA</div>
        </header>

        <div class="terminal-toolbar">
          <div class="toolbar-tabs mono"><span class="active">MARKET WORKSPACE</span><span>ORDER FLOW</span><span>SCENARIO LAB</span></div>
          <div class="context-inline">
            <span class="mono">{ui[3]}</span>
            <img src="/images/product/depthlume-market-context.webp" width="363" height="78" alt={alt[1]} />
          </div>
        </div>

        <div class="terminal-workspace">
          <section class="terminal-panel chart-panel">
            <div class="panel-title"><span class="mono">CANDLESTICK / MARKET STRUCTURE</span><span class="panel-state mono"><i></i>LIVE WORKSPACE</span></div>
            <div class="chart-canvas">
              <img src="/images/product/depthlume-chart-clean.webp" width="1040" height="762" alt={alt[0]} fetchpriority="high" />
              <div class="profile-rail" aria-label="Conceptual side volume profile">
                <span class="mono">PROFILE</span>
                <div><i class="ask" style="--volume:44%"></i></div>
                <div><i class="ask" style="--volume:73%"></i></div>
                <div><i class="ask" style="--volume:56%"></i></div>
                <div class="poc"><i style="--volume:88%"></i></div>
                <div><i class="bid" style="--volume:69%"></i></div>
                <div><i class="bid" style="--volume:82%"></i></div>
                <div><i class="bid" style="--volume:39%"></i></div>
              </div>
            </div>
          </section>

          <section class="terminal-panel watchlist-panel">
            <div class="panel-title"><span class="mono">WATCHLIST</span><span class="mono">MARKET TABLE</span></div>
            <img src="/images/product/depthlume-watchlist.webp" width="860" height="362" alt="DepthLume public-market watchlist table" />
          </section>

          <section class="terminal-panel delta-panel">
            <div class="panel-title"><span class="mono">DELTA / CVD</span><span class="mono">AGGRESSIVE FLOW</span></div>
            <img src="/images/product/depthlume-delta-cvd.webp" width="985" height="353" alt={alt[2]} />
          </section>

          <section class="terminal-panel intelligence-panel">
            <div class="panel-title"><span class="mono">MARKET INTELLIGENCE MAP</span><span class="mono">LIQUIDITY STRUCTURE</span></div>
            <img src="/images/product/depthlume-depth-map.webp" width="858" height="454" alt={alt[3]} />
          </section>
        </div>

        <footer class="terminal-statusbar mono">
          <span><i></i>WORKSPACE ACTIVE</span><span>LOCAL PROCESSING</span><span>NO ACCOUNT CONNECTION</span>
        </footer>
      </div>

      <div class="monitor-stand" aria-hidden="true"><i></i></div>
    </div>
  ) : (
    <div class="missing-product"><span>{ui[4]}</span></div>
  )}

  <figcaption>{caption}</figcaption>
</figure>

<style>
  .product-workspace { position: relative; min-width: 0; margin: 0; }
  .workspace-label { display: flex; justify-content: space-between; gap: 1rem; margin-bottom: .8rem; color: var(--color-text-muted); font-size: .75rem; }
  .workspace-label .mono { color: var(--color-cyan); font-size: .72rem; letter-spacing: .065em; text-transform: uppercase; }
  .workspace-stage { position: relative; min-height: 39rem; perspective: 1550px; isolation: isolate; }
  .monitor-aura { position: absolute; z-index: -1; inset: 8% 0 11%; border-radius: 50%; background: rgba(41,184,205,.1); filter: blur(75px); }
  .widescreen-monitor { position: absolute; z-index: 2; inset: .5rem .2rem 4.7rem; display: flex; flex-direction: column; overflow: hidden; border: 1px solid rgba(104,219,233,.34); border-radius: .8rem; background: #081119; box-shadow: 11px 8px 0 #10232d, 20px 18px 38px rgba(0,0,0,.4), -22px 36px 85px rgba(0,0,0,.48), inset 0 0 0 1px rgba(255,255,255,.025); transform: rotateY(-6deg) rotateX(1deg); transform-origin: center; }
  .widescreen-monitor::after { position: absolute; inset: 0; z-index: 10; pointer-events: none; content: ''; box-shadow: inset -2px 0 rgba(96,221,235,.18), inset 0 1px rgba(255,255,255,.04); }
  .terminal-titlebar { display: flex; min-height: 2.6rem; align-items: center; gap: .75rem; padding: .55rem .8rem; border-bottom: 1px solid var(--color-line); background: linear-gradient(180deg,#0d1c26,#09151e); color: var(--color-text-soft); font-size: .76rem; }
  .window-controls { display: flex; gap: .3rem; }
  .window-controls i { width: .42rem; height: .42rem; border-radius: 50%; background: var(--color-text-muted); opacity: .46; }
  .terminal-titlebar strong { font-weight: 620; }
  .terminal-titlebar strong span { color: var(--color-text-muted); font-weight: 450; }
  .terminal-health { display: flex; align-items: center; gap: .4rem; margin-left: auto; color: var(--color-text-muted); font-size: .66rem; }
  .terminal-health i, .panel-state i, .terminal-statusbar i { width: .4rem; height: .4rem; border-radius: 50%; background: var(--color-cyan); box-shadow: 0 0 8px rgba(96,221,235,.45); }
  .terminal-toolbar { display: flex; min-height: 3.2rem; align-items: center; gap: 1rem; padding: .4rem .7rem; border-bottom: 1px solid var(--color-line); background: #09151e; }
  .toolbar-tabs { display: flex; align-self: stretch; align-items: center; gap: .3rem; color: var(--color-text-muted); font-size: .63rem; }
  .toolbar-tabs span { padding: .55rem .6rem; border-radius: .25rem; white-space: nowrap; }
  .toolbar-tabs .active { background: var(--color-cyan-dim); color: var(--color-cyan); }
  .context-inline { display: flex; align-items: center; gap: .65rem; margin-left: auto; }
  .context-inline > span { color: var(--color-text-muted); font-size: .64rem; white-space: nowrap; }
  .context-inline img { width: 12.5rem; height: 2.7rem; border: 1px solid rgba(96,221,235,.2); border-radius: .25rem; object-fit: cover; }
  .terminal-workspace { display: grid; min-height: 0; flex: 1; grid-template-columns: minmax(0,1.55fr) minmax(13rem,.85fr); grid-template-rows: minmax(0,1fr) 9.7rem; gap: 1px; background: var(--color-line); }
  .terminal-panel { min-width: 0; min-height: 0; overflow: hidden; background: #111719; }
  .panel-title { display: flex; min-height: 2rem; align-items: center; justify-content: space-between; gap: .5rem; padding: .45rem .6rem; border-bottom: 1px solid var(--color-line); background: rgba(8,19,27,.98); color: var(--color-text-muted); font-size: .65rem; letter-spacing: .035em; }
  .panel-state { display: flex; align-items: center; gap: .35rem; }
  .chart-panel { display: flex; flex-direction: column; }
  .chart-canvas { position: relative; min-height: 0; flex: 1; overflow: hidden; }
  .chart-canvas > img { width: 100%; height: 100%; object-fit: cover; object-position: 52% 43%; }
  .profile-rail { position: absolute; top: .7rem; right: .5rem; bottom: .7rem; display: flex; width: 5.2rem; flex-direction: column; justify-content: center; padding: .45rem; border-left: 1px solid rgba(96,221,235,.16); background: linear-gradient(90deg,transparent,rgba(4,10,14,.72)); }
  .profile-rail > span { margin-bottom: .35rem; color: var(--color-text-muted); font-size: .58rem; text-align: right; }
  .profile-rail > div { position: relative; height: 1.05rem; }
  .profile-rail i { position: absolute; right: 0; top: 50%; width: var(--volume); height: .38rem; transform: translateY(-50%); background: var(--color-amber); opacity: .72; }
  .profile-rail i.ask { background: var(--color-red); } .profile-rail i.bid { background: var(--color-green); }
  .profile-rail .poc::before { position: absolute; inset: 50% 0 auto; height: 1px; background: var(--color-amber); content: ''; }
  .watchlist-panel { display: flex; flex-direction: column; }
  .watchlist-panel img { width: 100%; min-height: 0; flex: 1; object-fit: cover; object-position: left top; }
  .delta-panel, .intelligence-panel { display: flex; flex-direction: column; }
  .delta-panel img, .intelligence-panel img { width: 100%; min-height: 0; flex: 1; object-fit: cover; }
  .terminal-statusbar { display: flex; min-height: 1.8rem; align-items: center; justify-content: space-between; gap: .8rem; padding: .4rem .65rem; border-top: 1px solid rgba(96,221,235,.16); background: #07131b; color: var(--color-text-muted); font-size: .59rem; }
  .terminal-statusbar span:first-child { display: flex; align-items: center; gap: .35rem; color: var(--color-cyan); }
  .monitor-stand { position: absolute; z-index: 1; right: 33%; bottom: 1rem; width: 9rem; height: 4.2rem; border: 1px solid var(--color-line); border-top: 0; background: linear-gradient(90deg,#091117,#1a2a34 50%,#081015); clip-path: polygon(32% 0,68% 0,76% 72%,100% 86%,100% 100%,0 100%,0 86%,24% 72%); }
  .monitor-stand i { position: absolute; right: -2rem; bottom: 0; left: -2rem; height: .45rem; border-radius: 50%; background: #18262e; box-shadow: 0 7px 20px rgba(0,0,0,.45); }
  figcaption { max-width: 43rem; margin: .8rem 0 0 auto; color: var(--color-text-muted); font-size: .74rem; line-height: 1.5; text-align: right; }
  .missing-product { display: grid; min-height: 27rem; place-content: center; border: 1px dashed var(--color-line-strong); border-radius: .75rem; background: var(--color-panel); text-align: center; }

  @media (max-width: 1100px) {
    .workspace-stage { min-height: 36rem; }
    .terminal-workspace { grid-template-columns: minmax(0,1.4fr) minmax(12rem,.8fr); grid-template-rows: minmax(0,1fr) 8.7rem; }
    .context-inline img { width: 10rem; }
  }

  @media (max-width: 820px) {
    .workspace-label span:last-child { display: none; }
    .workspace-stage { min-height: auto; perspective: none; }
    .monitor-aura, .monitor-stand { display: none; }
    .widescreen-monitor { position: relative; inset: auto; height: 29rem; transform: none; box-shadow: 0 22px 55px rgba(0,0,0,.42), inset 0 0 0 1px rgba(255,255,255,.025); }
    .terminal-toolbar { min-height: 2.6rem; }
    .toolbar-tabs span:not(.active), .context-inline { display: none; }
    .terminal-workspace { grid-template-columns: 1fr; grid-template-rows: minmax(0,1fr) 9rem; }
    .watchlist-panel, .intelligence-panel { display: none; }
    .profile-rail { width: 4.3rem; }
    .terminal-statusbar span:not(:first-child) { display: none; }
    figcaption { text-align: left; }
  }

  @media (max-width: 420px) {
    .widescreen-monitor { height: 25rem; }
    .terminal-titlebar strong span, .terminal-health { display: none; }
    .panel-title span:last-child { display: none; }
    .profile-rail { display: none; }
  }
</style>
