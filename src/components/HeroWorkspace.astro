---
import { existsSync } from 'node:fs';
import { join } from 'node:path';
const screenshotExists = existsSync(join(process.cwd(), 'public', 'images', 'product', 'depthlume-terminal.webp'));
---
<div class="workspace-wrap">
  <div class="depth-marker mono" aria-hidden="true"><span>00</span><span>10</span><span>20</span><span>30</span><span>40</span></div>
  <div class="workspace panel">
    <div class="panel-head">
      <div class="workspace-brand"><span class="workspace-symbol"></span><strong>DepthLume</strong><span>/ Intelligence Workspace</span></div>
      <div class="workspace-state"><span class="status-dot"></span>CONCEPT PREVIEW</div>
    </div>
    {screenshotExists ? (
      <img class="real-terminal" src="/images/product/depthlume-terminal.webp" width="1200" height="760" alt="DepthLume market intelligence application interface" />
    ) : (
      <div class="workspace-grid">
        <section class="context-card">
          <div class="micro-head"><span>MARKET CONTEXT</span><span class="quality">DATA QUALITY / REVIEW</span></div>
          <div class="context-main">
            <div><span class="context-label">CONTEXT</span><strong>OBSERVE</strong></div>
            <span class="wait-badge">WAIT</span>
          </div>
          <div class="evidence-row"><span>Evidence</span><i style="--level: 78%"></i></div>
          <div class="evidence-row"><span>Conflicts</span><i style="--level: 36%"></i></div>
          <div class="evidence-row"><span>Data quality</span><i style="--level: 63%"></i></div>
          <p>Context strength is not a probability of profit.</p>
        </section>
        <section class="chart-card">
          <div class="micro-head"><span>DELTA / CVD</span><span>ILLUSTRATIVE</span></div>
          <svg viewBox="0 0 520 250" preserveAspectRatio="none" aria-hidden="true">
            <defs><linearGradient id="heroArea" x1="0" x2="0" y1="0" y2="1"><stop offset="0" stop-color="#60ddeb" stop-opacity=".22"/><stop offset="1" stop-color="#60ddeb" stop-opacity="0"/></linearGradient></defs>
            <g class="grid-lines"><path d="M0 50h520M0 100h520M0 150h520M0 200h520"/><path d="M104 0v250M208 0v250M312 0v250M416 0v250"/></g>
            <path class="area" d="M0 206C32 198 45 177 76 182s40 28 73 14 52-70 86-52 55 4 78-22 41-5 66-27 34-49 62-31 45-15 79-41v227H0Z"/>
            <path class="line" d="M0 206C32 198 45 177 76 182s40 28 73 14 52-70 86-52 55 4 78-22 41-5 66-27 34-49 62-31 45-15 79-41"/>
          </svg>
          <div class="chart-legend mono"><span><i class="cyan-dot"></i>CUMULATIVE FLOW</span><span>NO LIVE VALUES</span></div>
        </section>
        <section class="dom-card">
          <div class="micro-head"><span>DEPTH</span><span>DOM</span></div>
          <div class="dom-row ask"><i style="width:38%"></i><span>ASK</span><b>—</b></div>
          <div class="dom-row ask"><i style="width:72%"></i><span>ASK</span><b>—</b></div>
          <div class="dom-mid"><span>REFERENCE</span><strong>—</strong></div>
          <div class="dom-row bid"><i style="width:83%"></i><span>BID</span><b>—</b></div>
          <div class="dom-row bid"><i style="width:51%"></i><span>BID</span><b>—</b></div>
        </section>
        <section class="tape-card">
          <div class="micro-head"><span>TRADE TAPE</span><span>PUBLIC DATA</span></div>
          <div class="tape-head"><span>TIME</span><span>SIDE</span><span>SIZE</span></div>
          <div class="tape-row"><span>--:--:--</span><b class="up">BUY</b><span>—</span></div>
          <div class="tape-row"><span>--:--:--</span><b class="down">SELL</b><span>—</span></div>
          <div class="tape-row"><span>--:--:--</span><b class="up">BUY</b><span>—</span></div>
        </section>
        <section class="scenario-card">
          <div class="micro-head"><span>SCENARIO LAB</span><span>LIFECYCLE</span></div>
          <div class="scenario-flow"><span>CREATED</span><i></i><span>OBSERVED</span><i></i><span>EVALUATED</span></div>
        </section>
      </div>
    )}
    {!screenshotExists && <div class="replacement-note">Real DepthLume interface screenshot will replace this preview.</div>}
  </div>
  <div class="workspace-shadow" aria-hidden="true"></div>
</div>

<style>
  .workspace-wrap { position: relative; min-width: 0; perspective: 1200px; }
  .workspace { position: relative; z-index: 2; overflow: hidden; transform: rotateY(-2.4deg) rotateX(1deg); transform-origin: center left; box-shadow: -25px 36px 90px rgba(0,0,0,.38), 0 0 70px rgba(44,171,193,.07); }
  .workspace-brand { display: flex; align-items: center; gap: .45rem; min-width: 0; font-size: .7rem; }
  .workspace-brand span:last-child { overflow: hidden; color: var(--color-text-muted); text-overflow: ellipsis; white-space: nowrap; }
  .workspace-symbol { width: .8rem; height: .8rem; border: 1px solid var(--color-cyan); border-radius: .18rem; background: var(--color-cyan-dim); }
  .workspace-state { color: var(--color-text-muted); font: 600 .55rem/1 var(--font-mono); letter-spacing: .07em; white-space: nowrap; }
  .workspace-grid { display: grid; grid-template-columns: 1.1fr 1.8fr .85fr; grid-template-rows: 1fr .8fr auto; gap: 1px; min-height: 31rem; background: var(--color-line); }
  .workspace-grid > section { min-width: 0; padding: .8rem; background: rgba(7,17,25,.96); }
  .micro-head { display: flex; justify-content: space-between; gap: .4rem; margin-bottom: .85rem; color: var(--color-text-muted); font: 600 .52rem/1 var(--font-mono); letter-spacing: .07em; }
  .quality { color: var(--color-cyan); }
  .context-card { grid-row: 1 / 3; }
  .context-main { display: flex; align-items: center; justify-content: space-between; gap: .5rem; margin: 1rem 0 1.7rem; }
  .context-label { display: block; color: var(--color-text-muted); font: .52rem/1 var(--font-mono); }
  .context-main strong { color: var(--color-text); font: 500 1.35rem/1.2 var(--font-mono); }
  .wait-badge { padding: .35rem .5rem; border: 1px solid rgba(226,179,95,.25); border-radius: .25rem; background: rgba(226,179,95,.08); color: var(--color-amber); font: 650 .55rem/1 var(--font-mono); }
  .evidence-row { display: grid; grid-template-columns: 4.5rem 1fr; align-items: center; gap: .5rem; margin: .7rem 0; color: var(--color-text-muted); font: .55rem/1 var(--font-mono); }
  .evidence-row i { position: relative; height: 2px; background: rgba(255,255,255,.06); }
  .evidence-row i::after { position: absolute; inset: 0 auto 0 0; width: var(--level); content: ''; background: var(--color-cyan); opacity: .65; }
  .context-card p { margin-top: 1.5rem; font: .52rem/1.5 var(--font-mono); }
  .chart-card { grid-column: 2; grid-row: 1 / 3; display: flex; flex-direction: column; }
  .chart-card svg { flex: 1; width: 100%; min-height: 13rem; }
  .grid-lines path { fill: none; stroke: rgba(145,190,207,.09); stroke-width: 1; }
  .area { fill: url(#heroArea); }
  .line { fill: none; stroke: var(--color-cyan); stroke-width: 1.8; vector-effect: non-scaling-stroke; filter: drop-shadow(0 0 6px rgba(96,221,235,.3)); }
  .chart-legend { display: flex; justify-content: space-between; gap: .5rem; color: var(--color-text-muted); font-size: .48rem; }
  .cyan-dot { display: inline-block; width: .35rem; height: .35rem; margin-right: .3rem; border-radius: 50%; background: var(--color-cyan); }
  .dom-card { grid-column: 3; grid-row: 1; }
  .dom-row { position: relative; display: grid; grid-template-columns: 1fr auto; padding: .42rem .3rem; overflow: hidden; font: .5rem/1 var(--font-mono); }
  .dom-row i { position: absolute; inset: 2px 0 2px auto; opacity: .13; }
  .dom-row.ask i { background: var(--color-red); } .dom-row.bid i { background: var(--color-green); }
  .dom-row.ask span { color: var(--color-red); } .dom-row.bid span { color: var(--color-green); }
  .dom-mid { display: flex; justify-content: space-between; margin: .2rem -.8rem; padding: .5rem .8rem; border-block: 1px solid var(--color-line); color: var(--color-text-muted); font: .48rem/1 var(--font-mono); }
  .tape-card { grid-column: 3; grid-row: 2; }
  .tape-head, .tape-row { display: grid; grid-template-columns: 1.4fr 1fr .5fr; gap: .25rem; padding: .35rem 0; font: .48rem/1 var(--font-mono); }
  .tape-head { color: var(--color-text-muted); }
  .tape-row { border-top: 1px solid rgba(145,190,207,.08); color: var(--color-text-soft); }
  .up { color: var(--color-green); } .down { color: var(--color-red); }
  .scenario-card { grid-column: 1 / 4; padding-block: .65rem !important; }
  .scenario-card .micro-head { margin-bottom: .6rem; }
  .scenario-flow { display: grid; grid-template-columns: auto 1fr auto 1fr auto; align-items: center; gap: .6rem; color: var(--color-text-soft); font: .5rem/1 var(--font-mono); }
  .scenario-flow i { height: 1px; background: linear-gradient(90deg, var(--color-cyan), var(--color-line)); }
  .replacement-note { padding: .55rem 1rem; border-top: 1px solid var(--color-line); background: rgba(96,221,235,.035); color: var(--color-text-muted); text-align: center; font: .52rem/1.3 var(--font-mono); letter-spacing: .04em; }
  .real-terminal { width: 100%; height: auto; background: var(--color-panel); }
  .depth-marker { position: absolute; z-index: 3; top: 4.5rem; left: -2.4rem; display: flex; height: 75%; flex-direction: column; justify-content: space-between; color: var(--color-text-muted); font-size: .48rem; opacity: .7; }
  .depth-marker::after { position: absolute; top: 0; bottom: 0; left: 1.75rem; width: 1px; content: ''; background: linear-gradient(var(--color-cyan), transparent); opacity: .4; }
  .workspace-shadow { position: absolute; z-index: 1; right: -5%; bottom: -8%; left: 8%; height: 38%; background: rgba(30,160,183,.12); filter: blur(70px); transform: rotate(-4deg); }
  @media (max-width: 720px) {
    .workspace { transform: none; }
    .workspace-grid { grid-template-columns: 1fr 1.6fr; grid-template-rows: 1fr auto; min-height: 23rem; }
    .context-card { grid-row: 1; }
    .chart-card { grid-column: 2; grid-row: 1; }
    .dom-card, .tape-card { display: none; }
    .scenario-card { grid-column: 1 / 3; grid-row: 2; }
    .depth-marker { display: none; }
  }
  @media (max-width: 430px) {
    .workspace-grid { grid-template-columns: 1fr; grid-template-rows: auto auto; }
    .context-card { display: none; }
    .chart-card { grid-column: 1; grid-row: 1; }
    .scenario-card { grid-column: 1; grid-row: 2; }
    .workspace-state { display: none; }
    .chart-card svg { min-height: 10rem; }
  }
</style>
