---
interface Props { icon: string; title: string; text: string; }
const { icon, title, text } = Astro.props;
const icons: Record<string, string> = {
  flow: '<path d="M3 15V9m6 6V4m6 11V7m6 8V2"/>',
  ladder: '<path d="M4 3v18M20 3v18M4 7h10M10 11h10M4 15h8m-2 4h10"/>',
  delta: '<path d="m12 3 8 17H4L12 3Z"/><path d="M8 15h8"/>',
  pulse: '<path d="M2 13h4l2-7 4 13 3-10 2 4h5"/>',
  whale: '<path d="M3 13c2-1 3-3 3-6 2 1 3 3 3 5 3-2 7-2 10 0l2-2c0 6-4 10-10 10-5 0-8-2-8-7Z"/>',
  ice: '<path d="m12 2 8 5v10l-8 5-8-5V7l8-5Z"/><path d="m4 7 8 5 8-5M12 12v10"/>',
  context: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
  history: '<path d="M4 5v5h5M5.5 18a9 9 0 1 0-1.2-10"/><path d="M12 7v6l4 2"/>',
  scenario: '<path d="M4 20V9m8 11V4m8 16v-7"/><path d="M2 20h20"/>',
  record: '<rect x="4" y="3" width="16" height="18" rx="2"/><path d="M8 8h8M8 12h8M8 16h5"/>',
  journal: '<path d="M5 3h14v18H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2Z"/><path d="M7 3v18m4-13h5m-5 4h5"/>',
  diagnostic: '<path d="M12 3v3m0 12v3M3 12h3m12 0h3M5.6 5.6l2.1 2.1m8.6 8.6 2.1 2.1M18.4 5.6l-2.1 2.1m-8.6 8.6-2.1 2.1"/><circle cx="12" cy="12" r="3"/>',
};
---
<article class="feature-card">
  <div class="feature-icon" aria-hidden="true">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={icons[icon] ?? icons.context}></svg>
  </div>
  <h3>{title}</h3>
  <p>{text}</p>
</article>
