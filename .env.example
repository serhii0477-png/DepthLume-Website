# Local Pages Functions development only. Never commit real secrets.
APP_ENV=development
APP_URL=http://localhost:8788
BETA_LIMIT=10
ADMIN_BOOTSTRAP_SECRET=replace-with-a-long-random-secret
# Large direct-to-R2 release uploads. Create a bucket-scoped R2 S3 API token;
# keep its values only in .dev.vars / Cloudflare production secrets.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
RESEND_API_KEY=
EMAIL_FROM=DepthLume <access@example.com>
