{
  "name": "depthlume-website",
  "version": "1.0.0-beta.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "dev:full": "npm run build && wrangler pages dev dist --persist-to .wrangler/state --live-reload",
    "start": "astro dev",
    "check": "astro check",
    "build": "astro check && astro build && node scripts/validate-build.mjs",
    "preview": "astro preview",
    "test": "node --test tests/*.test.mjs",
    "db:migrate:local": "wrangler d1 migrations apply depthlume-website --local",
    "db:migrate:remote": "wrangler d1 migrations apply depthlume-website --remote"
  },
  "dependencies": {
    "@astrojs/sitemap": "latest",
    "astro": "7.1.4"
  },
  "devDependencies": {
    "@astrojs/check": "latest",
    "@cloudflare/workers-types": "^5.20260804.1",
    "typescript": "latest",
    "wrangler": "^4.119.0"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "overrides": {
    "undici": "^7.29.0"
  }
}
